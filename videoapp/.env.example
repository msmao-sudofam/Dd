# Copy to .env.local and fill in. Anything left empty falls back to a mock so the app still runs.
# See HANDOFF.md for where to get each key.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Reelforge
# Comma-separated emails that get the admin role
ADMIN_EMAILS=
# Long random string; signs mock sessions + internal tokens (openssl rand -hex 32)
SESSION_SECRET=

# --- Mock switches (true = force mock even if keys exist) ---
MOCK_BACKEND=
MOCK_PROVIDERS=
MOCK_STRIPE=
# Where the mock backend keeps its JSON DB + uploaded files
MOCK_DB_PATH=.data/mock-db.json

# --- Supabase (Auth + Postgres + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Model providers ---
FAL_KEY=
REPLICATE_API_TOKEN=
REPLICATE_WEBHOOK_SECRET=
# Self-hosted Wan/LTX on RunPod Serverless (Phase 5)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Shared secret appended to RunPod webhook URLs (RunPod doesn't sign webhooks)
SELF_WEBHOOK_SECRET=

# --- Moderation ---
OPENAI_API_KEY=

# --- Payments (TEST MODE keys: sk_test_..., whsec_...) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email / analytics ---
RESEND_API_KEY=
EMAIL_FROM="Reelforge <noreply@yourdomain.com>"
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Legal / support (shown on legal pages) ---
LEGAL_COMPANY_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Abuse limits (optional overrides) ---
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_DAY=200
SIGNUP_MAX_PER_IP=3
