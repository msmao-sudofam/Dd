// Generates supabase/seed.sql from src/lib/seed-data.ts so Supabase and the mock DB share one catalog.
// Run: npm run gen:seed
import { writeFileSync } from "node:fs";
import { SEED_MODELS, SEED_PRESETS } from "../src/lib/seed-data.ts";

const q = (v: unknown): string => {
  if (v === null || v === undefined) return "null";
  if (typeof v === "number" || typeof v === "boolean") return String(v);
  if (Array.isArray(v)) {
    const isNum = v.every((x) => typeof x === "number");
    return `array[${v.map(q).join(",")}]::${isNum ? "integer" : "text"}[]`.replace("array[]::integer[]", "'{}'::integer[]").replace("array[]::text[]", "'{}'::text[]");
  }
  if (typeof v === "object") return `'${JSON.stringify(v).replaceAll("'", "''")}'::jsonb`;
  return `'${String(v).replaceAll("'", "''")}'`;
};

const out: string[] = ["-- GENERATED by scripts/gen-seed-sql.mts — do not edit by hand.", "begin;", ""];

for (const m of SEED_MODELS) {
  const cols = Object.keys(m);
  out.push(
    `insert into public.models (${cols.join(", ")}) values (${cols.map((c) => q((m as Record<string, unknown>)[c])).join(", ")})\n` +
      `on conflict (slug) do update set ${cols.filter((c) => c !== "slug").map((c) => `${c} = excluded.${c}`).join(", ")};`,
  );
}
out.push("");
for (const { model_slug, ...p } of SEED_PRESETS) {
  const cols = Object.keys(p);
  out.push(
    `insert into public.presets (${cols.join(", ")}, model_id) select ${cols.map((c) => q((p as Record<string, unknown>)[c])).join(", ")}, id from public.models where slug = ${q(model_slug)}\n` +
      `on conflict (slug) do update set ${[...cols.filter((c) => c !== "slug"), "model_id"].map((c) => `${c} = excluded.${c}`).join(", ")};`,
  );
}
out.push("", "commit;", "");
writeFileSync(new URL("../supabase/seed.sql", import.meta.url), out.join("\n"));
console.log(`seed.sql: ${SEED_MODELS.length} models, ${SEED_PRESETS.length} presets`);
